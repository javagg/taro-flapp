{
    "files": ["index.ts"],
    "compilerOptions": {
      "target": "es2015",
      "module": "es2015",
      "declaration": true,
      "outDir": "./dist",
      "noEmit": false,
      "strict": true,
      "noImplicitAny": true,
      "strictFunctionTypes": true,
      "strictBindCallApply": true,
      "strictPropertyInitialization": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "moduleResolution": "node",
    }
  }